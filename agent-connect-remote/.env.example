# CockroachDB connection
COCKROACH_CONNECTION_STRING=postgresql://user:password@host:26257/deltomic?sslmode=require

# AWS credentials for SSM
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Agent model (conversation)
AGENT_MODEL=google_genai:gemini-3.6-flash
GOOGLE_API_KEY=

# Groq (execution sub-agent)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MAX_TOKENS=4096

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-connect-remote

# Pingram email
PINGRAM_API_KEY=

# Composio (Google Calendar for Meet links)
COMPOSIO_API_KEY=

# Backend
BACKEND_URL=https://your-ngrok-url.ngrok-free.dev
