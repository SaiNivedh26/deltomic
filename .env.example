# AssemblyAI - Speech-to-Text provider
# Get your API key at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Cartesia - Text-to-Speech provider
# Get your API key at: https://cartesia.ai/
CARTESIA_API_KEY=

# LangChain Agent Model
# Format: provider:model-name
# Examples:
#   google_genai:gemini-3.6-flash
#   openai:gpt-4o
#   anthropic:claude-3-5-sonnet
AGENT_MODEL=google_genai:gemini-3.6-flash

# Google Gemini API key (required if using google_genai provider)
# Get your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=

# OpenAI API key (required if using openai provider)
# OPENAI_API_KEY=

# Anthropic API key (required if using anthropic provider)
# ANTHROPIC_API_KEY=

# LangSmith - Tracing & observability (optional)
# Sign up at: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=